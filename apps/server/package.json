    "photon:roundtrip": "tsx --env-file-if-exists=../../.env src/integrations/photon/roundtrip.ts"
  },
  "dependencies": {
    "@quakenet/shared": "*",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "spectrum-ts": "12.10.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0"
  }
}
